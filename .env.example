# Database connection URL (PostgreSQL with production connection pooling: connection_limit=20&pool_timeout=10)
DATABASE_URL="postgresql://user:password@localhost:5432/cloud_saas?schema=public&connection_limit=20&pool_timeout=10"

# Redis connection URL
REDIS_URL="redis://:password@localhost:6379"

# JWT Secret for Tenant Authentication
JWT_SECRET="your-jwt-secret-here"

# Session Cookie Signing Secret (Double-Submit CSRF & Auth Cookies)
COOKIE_SECRET="your-cookie-secret-here"

# AES-256-GCM Encryption Key (64-character hex string / 32 bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application Port
PORT=3000

# Swagger / OpenAPI Docs UI (default false in production, true in local dev)
SWAGGER_ENABLED="false"

# Docker Compose Database Credentials
POSTGRES_USER="yoursmmagent"
POSTGRES_PASSWORD="please-change-this-postgres-password-in-production"
POSTGRES_DB="yoursmmagent_db"

# Chat Message Retention Days (default 90)
CHAT_RETENTION_DAYS=90

# Master Platform AI Engine (SaaS provides AI; tenants do NOT need keys)
# Supported providers: openrouter | openai | gemini | anthropic | nvidia | groq | deepseek | custom
AI_PROVIDER="openrouter"
AI_API_KEY=""
AI_MODEL="google/gemini-2.0-flash-001"
AI_BASE_URL=""
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="600"

# Application Public URL
APP_URL="https://app.yoursmmagent.com"

# Google Single Sign-On (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=""

# SMTP Email Dispatch Service (Nodemailer)
# If unconfigured, emails will be logged to server stdout during local testing
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="YourSMMagent Support <no-reply@yoursmmagent.com>"

# Cryptomus Automated Crypto Payments
CRYPTOMUS_MERCHANT_ID=""
CRYPTOMUS_PAYMENT_KEY=""

# WhatsApp Multi-Session Auth Directory (default: ./baileys_auth, container: /app/baileys_auth)
WHATSAPP_AUTH_DIR="./baileys_auth"

