{
  "name": "cloud-saas",
  "version": "1.0.0",
  "description": "Multi-Tenant AI Customer Support Platform for SMM Panels (Telegram, WhatsApp, Web Widget)",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:all": "tsc && npm run landing:build",
    "start": "node dist/src/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "landing:dev": "npm --prefix landing run dev",
    "landing:build": "npm --prefix landing run build",
    "landing:preview": "npm --prefix landing run preview",
    "dev:landing": "npm --prefix landing run dev",
    "start:landing": "npm --prefix landing run dev",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.4.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "^11.3.2",
    "grammy": "^1.35.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "openai": "^7.47.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.12.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
